# qmk-state-daemon developer & install commands.
#
# Run `just` (or `just --list`) to see all recipes.

set shell := ["bash", "-euo", "pipefail", "-c"]

BIN := "qmk-state-daemon"
INSTALL_DIR := env_var_or_default("CARGO_INSTALL_ROOT", env_var("HOME") + "/.local") + "/bin"
PLIST := "com.user.qmk-state-daemon.plist"
PLIST_SRC := justfile_directory() + "/launchd/" + PLIST
PLIST_DST := env_var("HOME") + "/Library/LaunchAgents/" + PLIST
LAUNCHD_LABEL := "com.user.qmk-state-daemon"
SYSTEMD_UNIT := "qmk-state-daemon.service"
SYSTEMD_SRC := justfile_directory() + "/systemd/" + SYSTEMD_UNIT
SYSTEMD_DST := env_var("HOME") + "/.config/systemd/user/" + SYSTEMD_UNIT
CONFIG_PATH := env_var_or_default("XDG_CONFIG_HOME", env_var("HOME") + "/.config") + "/qmk-state-daemon/config.toml"

default:
    @just --list

# --- build / test ---

build:
    cargo build --release

test:
    cargo test

lint:
    cargo clippy --all-targets -- -D warnings

fmt:
    cargo fmt

# --- daemon install ---

install: build
    mkdir -p "{{ INSTALL_DIR }}"
    install -m 0755 target/release/{{ BIN }} "{{ INSTALL_DIR }}/{{ BIN }}"
    @echo "installed → {{ INSTALL_DIR }}/{{ BIN }}"

uninstall:
    rm -f "{{ INSTALL_DIR }}/{{ BIN }}"

# --- launchd ---

install-launchd: install
    mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
    sed "s|%HOME%|$HOME|g" "{{ PLIST_SRC }}" > "{{ PLIST_DST }}"
    launchctl bootstrap gui/$UID "{{ PLIST_DST }}" 2>/dev/null || \
      (launchctl bootout gui/$UID "{{ PLIST_DST }}" && \
       launchctl bootstrap gui/$UID "{{ PLIST_DST }}")
    launchctl enable gui/$UID/{{ LAUNCHD_LABEL }}
    launchctl kickstart -k gui/$UID/{{ LAUNCHD_LABEL }}
    @echo "launchd agent loaded: {{ LAUNCHD_LABEL }}"
    @echo "logs: ~/Library/Logs/qmk-state-daemon.{out,err}.log"

uninstall-launchd:
    -launchctl bootout gui/$UID "{{ PLIST_DST }}"
    rm -f "{{ PLIST_DST }}"

launchd-status:
    launchctl print gui/$UID/{{ LAUNCHD_LABEL }} 2>/dev/null | head -30 || \
      echo "not loaded"

launchd-logs:
    tail -F "$HOME/Library/Logs/qmk-state-daemon.out.log" "$HOME/Library/Logs/qmk-state-daemon.err.log"

# Temporarily release the raw-HID interface so Vial GUI or the direct
# Python fallback can open it.
pause-launchd:
    -launchctl bootout gui/$UID "{{ PLIST_DST }}"
    @echo "qmk-state-daemon stopped; raw-HID is now free for Vial / direct tools"

# Resume the daemon after using Vial/direct HID and restart the launchd
# job cleanly.
resume-launchd: install
    mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
    sed "s|%HOME%|$HOME|g" "{{ PLIST_SRC }}" > "{{ PLIST_DST }}"
    launchctl bootstrap gui/$UID "{{ PLIST_DST }}" 2>/dev/null || \
      (launchctl bootout gui/$UID "{{ PLIST_DST }}" && \
       launchctl bootstrap gui/$UID "{{ PLIST_DST }}")
    launchctl enable gui/$UID/{{ LAUNCHD_LABEL }}
    launchctl kickstart -k gui/$UID/{{ LAUNCHD_LABEL }}
    @echo "qmk-state-daemon resumed"
    @echo "tip: run 'sketchybar --reload' if the qmk items were stale"

restart-launchd: pause-launchd resume-launchd

# --- systemd user service (Linux) ---

install-systemd-user: install
    mkdir -p "$HOME/.config/systemd/user"
    install -m 0644 "{{ SYSTEMD_SRC }}" "{{ SYSTEMD_DST }}"
    if [ ! -f "{{ CONFIG_PATH }}" ]; then "{{ INSTALL_DIR }}/{{ BIN }}" write-default-config --path "{{ CONFIG_PATH }}"; fi
    systemctl --user daemon-reload
    systemctl --user enable --now {{ SYSTEMD_UNIT }}
    @echo "systemd user service loaded: {{ SYSTEMD_UNIT }}"
    @echo "config: {{ CONFIG_PATH }}"
    @echo "status: just systemd-status"
    @echo "logs: just systemd-logs"

uninstall-systemd-user:
    -systemctl --user disable --now {{ SYSTEMD_UNIT }}
    rm -f "{{ SYSTEMD_DST }}"
    systemctl --user daemon-reload

restart-systemd-user: install
    systemctl --user restart {{ SYSTEMD_UNIT }}

systemd-status:
    systemctl --user status {{ SYSTEMD_UNIT }} --no-pager

systemd-logs:
    journalctl --user -u {{ SYSTEMD_UNIT }} -f

reload-config:
    "{{ INSTALL_DIR }}/{{ BIN }}" reload-config

# Install a udev rule that grants users in the input group access to the
# raw-HID interface. Pass lowercase or uppercase hex, with or without 0x.
install-udev-rule vid="303a" pid="4044":
    rule='/etc/udev/rules.d/70-qmk-state-daemon.rules'; \
    vid_clean=$$(printf '%s' '{{ vid }}' | tr '[:upper:]' '[:lower:]' | sed 's/^0x//'); \
    pid_clean=$$(printf '%s' '{{ pid }}' | tr '[:upper:]' '[:lower:]' | sed 's/^0x//'); \
    printf 'KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="%s", ATTRS{idProduct}=="%s", TAG+="uaccess", GROUP="input", MODE="0660"\n' "$$vid_clean" "$$pid_clean" | sudo tee "$$rule" >/dev/null; \
    sudo udevadm control --reload-rules; \
    sudo udevadm trigger; \
    printf 'installed %s for %s:%s\n' "$$rule" "$$vid_clean" "$$pid_clean"; \
    printf 'unplug/replug the keyboard, then run: just detect\n'

udev-rule-help vid="303a" pid="4044":
    @echo "Run: just install-udev-rule {{ vid }} {{ pid }}"
    @echo "Then unplug/replug the keyboard and verify with: just detect"

# --- convenience ---

detect:
    ./target/release/{{ BIN }} list

run-dry:
    ./target/release/{{ BIN }} run --dry-run

i3status-example-paths:
    @echo "command sink helper: {{ justfile_directory() }}/examples/i3status-rust/qmk-state-to-file.sh"
    @echo "i3status-rust snippet: {{ justfile_directory() }}/examples/i3status-rust/config-example.toml"
