# Alex svalboard keymap tooling.
#
# Run `just` (or `just --list`) to see all recipes.
#
# QSID commands go through the qmk-state-daemon RPC socket, so the
# daemon must be running (launchctl bootstrap com.user.qmk-state-daemon).
# The Python script (vial-qs.py) is kept as a fallback for the case
# where the daemon is stopped and you want direct HID access without
# starting it.

set shell := ["bash", "-euo", "pipefail", "-c"]

DAEMON := "qmk-state-daemon"
PLIST := "$HOME/Library/LaunchAgents/com.user.qmk-state-daemon.plist"

default:
    @just --list

# --- Vial QMK-Settings via daemon RPC (recommended) ---

# List all supported QSIDs.
list:
    {{ DAEMON }} qsid list

# Read a QSID value. Width is resolved from quantum/qmk_settings.c via
# `vial-qs.py width` (verified by `just py-check`); pass a third arg to override.
# Example: `just get 28`
get qsid width="":
    #!/usr/bin/env bash
    set -euo pipefail
    w="{{ width }}"
    [[ -z "$w" ]] && w="$(uv run --quiet --project . vial-qs.py width {{ qsid }})"
    {{ DAEMON }} qsid get {{ qsid }} --width "$w"

# Write a QSID value. Same width resolution as `get`. Example: `just set 2 120`
set qsid value width="":
    #!/usr/bin/env bash
    set -euo pipefail
    w="{{ width }}"
    [[ -z "$w" ]] && w="$(uv run --quiet --project . vial-qs.py width {{ qsid }})"
    {{ DAEMON }} qsid set {{ qsid }} {{ value }} --width "$w"

# --- shortcuts for the flow-tap QSIDs (see keymap.c) ---

flow-term-get:
    @just get 27

flow-term-set value:
    @just set 27 {{ value }}

flow-delta-get:
    @just get 28

flow-delta-set value:
    @just set 28 {{ value }}

flow-clamp-get:
    @just get 29

flow-clamp-set value:
    @just set 29 {{ value }}

flow-status:
    @printf 'term (qsid 27): ' && just flow-term-get
    @printf 'delta (qsid 28): ' && just get 28
    @printf 'clamp (qsid 29): ' && just get 29

# --- daemon handoff helpers ---

# Release the raw-HID interface so Vial GUI or the direct Python tool
# can open it.
daemon-pause:
    -launchctl bootout gui/$UID {{ PLIST }}
    @echo "daemon paused; you can now use Vial GUI or the py-* recipes"

# Resume the daemon and reclaim raw-HID.
daemon-resume:
    launchctl bootstrap gui/$UID {{ PLIST }} 2>/dev/null || \
      (launchctl bootout gui/$UID {{ PLIST }} && \
       launchctl bootstrap gui/$UID {{ PLIST }})
    launchctl kickstart -k gui/$UID/com.user.qmk-state-daemon
    @echo "daemon resumed"
    @echo "tip: run 'sketchybar --reload' if the qmk items look stale"

daemon-restart: daemon-pause daemon-resume

# --- live keymap: read what is actually bound on the board ---

# Protocol + uid + flashed firmware version.
layer-info:
    uv run --quiet --project . vial-layer.py info

# Full physical layout of a layer. Example: `just layer-dump 5`
layer-dump layer:
    uv run --quiet --project . vial-layer.py dump --layer {{ layer }}

# Only the tap-hold (mod-tap / layer-tap) keys of a layer.
layer-taps layer:
    uv run --quiet --project . vial-layer.py taps --layer {{ layer }}

# Live combo table (Vial dynamic combos) read off the board.
layer-combos:
    uv run --quiet --project . vial-layer.py combos

# Save a full config fingerprint (firmware + QSIDs + layers + combos) as JSON.
layer-fingerprint name:
    uv run --quiet --project . vial-layer.py fingerprint --layers 0,5,6 --out board-fingerprints/{{ name }}.json

# Compare two fingerprints. Example: `just layer-diff a b` (names without .json)
layer-diff a b:
    uv run --quiet --project . vial-layer.py diff board-fingerprints/{{ a }}.json board-fingerprints/{{ b }}.json

# One cell. Example: `just layer-cell 5 2`
layer-cell row col:
    uv run --quiet --project . vial-layer.py cell --row {{ row }} --col {{ col }}

# --- live firmware state (layers + real/weak/one-shot mods) ---

# Watch the board's 0xAB state broadcasts. Requires the daemon paused.
state-watch secs="10":
    uv run --quiet --project . sval-state.py {{ secs }}

# Capture a power-on: pauses the daemon, waits for you to double-tap reset or
# re-seat the cable, streams state, then resumes the daemon.
boot-watch secs="25":
    #!/usr/bin/env bash
    set -euo pipefail
    just daemon-pause
    trap 'just daemon-resume' EXIT
    echo ">>> double-tap RESET (or unplug/replug) with your fingers ON the home pads"
    uv run --quiet --project . sval-state.py {{ secs }}

# --- fallback: direct HID via Python ---
#
# WHY THIS EXISTS: the raw-HID interface is exclusive. qmk-state-daemon holds it
# open to poll layer state, so Vial GUI and vial-qs.py can only get a handle while
# the daemon is paused. `just daemon-pause`, do the direct-HID thing, `just
# daemon-resume`. If the daemon is healthy prefer the `get` / `set` / `flow-*`
# recipes above - same writes, richer output, nothing to stop.
#
# `py-names` and `py-check` need no device and no daemon at all.

# Print the built-in QSID table. No keyboard, no daemon.
py-names:
    uv run --project . vial-qs.py names

# Ask the keyboard which QSIDs it actually supports. Needs the daemon paused.
py-list:
    uv run --project . vial-qs.py list

# Read every interesting QSID in one session. Needs the daemon paused.
py-dump:
    uv run --project . vial-qs.py dump

py-get qsid:
    uv run --project . vial-qs.py get {{ qsid }}

py-set qsid value:
    uv run --project . vial-qs.py set {{ qsid }} {{ value }}

# Diff this tool's QSID table against quantum/qmk_settings.c. No device needed.
py-check:
    uv run --project . vial-qs.py check

sync:
    uv sync
